{{!
    @template local_jedomi/admin/agent_table

    Agent list of the Agents tab, with its header and rows. Included by local_jedomi/admin/agents_tab with a
    loading row, and rendered by the local_jedomi/admin/agents module, which replaces the contents of the
    table wrapper with each page of agents.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="local_jedomi/admin/agents/table-body" on the table body
    * data-agent-action (details, edit, run, toggle, delete) and data-agent-id on each menu item

    Blocks:
    * tablebody - Content of the table body; defaults to the agent rows or the empty-state row

    Context variables required for this template:
    * hasrows bool - Whether there are agents
    * rows array - Agents: id int, userid int, creator string, name string, schedule string (cron expression),
      schedulelabel string (readable schedule), enabled bool,
      lastrun int (0 when never run), failcount int (consecutive failed runs), canmanage bool (whether the user may edit, run,
      toggle or delete it)

    Example context (json):
    {
        "hasrows": true,
        "rows": [{"id": 3, "userid": 2, "creator": "Admin User", "name": "Daily report", "schedule": "0 0 * * *",
            "schedulelabel": "Every day at 00:00",
            "enabled": true, "lastrun": 1700000000, "failcount": 0, "canmanage": true}]
    }
}}
<table class="table table-sm table-hover small">
    <thead>
        <tr>
            <th scope="col">{{#str}} agent_creator, local_jedomi {{/str}}</th>
            <th scope="col">{{#str}} agent_name, local_jedomi {{/str}}</th>
            <th scope="col">{{#str}} agent_schedule, local_jedomi {{/str}}</th>
            <th scope="col">{{#str}} agent_status, local_jedomi {{/str}}</th>
            <th scope="col">{{#str}} agent_lastrun, local_jedomi {{/str}}</th>
            <th scope="col">{{#str}} agent_actions, local_jedomi {{/str}}</th>
        </tr>
    </thead>
    <tbody data-region="local_jedomi/admin/agents/table-body">
        {{$tablebody}}
            {{#hasrows}}
            {{#rows}}
            <tr>
                <td>{{#creator}}{{creator}}{{/creator}}{{^creator}}{{#str}} agent_user_id, local_jedomi, {{userid}} {{/str}}{{/creator}}</td>
                <td><strong>{{#name}}{{name}}{{/name}}{{^name}}{{#str}} agent_unnamed, local_jedomi {{/str}} #{{id}}{{/name}}</strong></td>
                <td title="{{schedule}}">{{schedulelabel}}</td>
                <td>
                    {{#enabled}}<span class="badge badge-success bg-success">{{#str}} agent_enabled, local_jedomi {{/str}}</span>{{/enabled}}
                    {{^enabled}}<span class="badge badge-secondary bg-secondary">{{#str}} agent_disabled, local_jedomi {{/str}}</span>{{/enabled}}
                    {{#failcount}}<span class="badge badge-danger bg-danger" title="{{#str}} agent_failing_count, local_jedomi, {{failcount}} {{/str}}">{{#str}} agent_failing, local_jedomi {{/str}}</span>{{/failcount}}
                </td>
                <td>{{#lastrun}}{{#userdate}} {{lastrun}}, {{#str}} strftimedatetimeshort, core_langconfig {{/str}} {{/userdate}}{{/lastrun}}{{^lastrun}}-{{/lastrun}}</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                                title="{{#str}} agent_actions_menu, local_jedomi {{/str}}">
                            <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                            <span class="sr-only visually-hidden">{{#str}} agent_actions_menu, local_jedomi {{/str}}</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a class="dropdown-item" href="#" data-agent-action="details" data-agent-id="{{id}}"><i class="fa fa-eye mr-2" aria-hidden="true"></i>{{#str}} agent_view_details, local_jedomi {{/str}}</a>
                            {{#canmanage}}
                            <a class="dropdown-item" href="#" data-agent-action="edit" data-agent-id="{{id}}"><i class="fa fa-pen mr-2" aria-hidden="true"></i>{{#str}} agent_edit, local_jedomi {{/str}}</a>
                            <a class="dropdown-item" href="#" data-agent-action="run" data-agent-id="{{id}}"><i class="fa fa-play mr-2" aria-hidden="true"></i>{{#str}} agent_run_now, local_jedomi {{/str}}</a>
                            <a class="dropdown-item" href="#" data-agent-action="toggle" data-agent-id="{{id}}">
                                {{#enabled}}<i class="fa fa-toggle-off mr-2" aria-hidden="true"></i>{{#str}} agent_disable, local_jedomi {{/str}}{{/enabled}}
                                {{^enabled}}<i class="fa fa-toggle-on mr-2" aria-hidden="true"></i>{{#str}} agent_enable, local_jedomi {{/str}}{{/enabled}}
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item text-danger" href="#" data-agent-action="delete" data-agent-id="{{id}}"><i class="fa fa-trash-alt mr-2" aria-hidden="true"></i>{{#str}} agent_delete, local_jedomi {{/str}}</a>
                            {{/canmanage}}
                        </div>
                    </div>
                </td>
            </tr>
            {{/rows}}
            {{/hasrows}}
            {{^hasrows}}
            <tr><td colspan="6" class="text-center text-muted py-4">{{#str}} agent_no_results, local_jedomi {{/str}}</td></tr>
            {{/hasrows}}
        {{/tablebody}}
    </tbody>
</table>
