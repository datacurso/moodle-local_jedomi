{{!
    @template local_jedomi/admin/ws_table

    Web service table of the APIs tab, with its header and rows. Rendered by local_jedomi/admin/apis_tab and
    again by the local_jedomi/admin/apis module, which replaces the contents of the table wrapper when the
    filters change.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-action="local_jedomi/admin/apis/check-all" on the select-all box
    * data-region="local_jedomi/admin/apis/rows" on the table body
    * data-region="local_jedomi/admin/apis/ws-check" on each row checkbox

    Context variables required for this template:
    * role string - Role key, used in the checkbox name
    * hasrows bool - Whether there are rows
    * rows array - Rows: name string, description string, component string, iswrite bool, checked bool

    Example context (json):
    {
        "role": "admin",
        "hasrows": true,
        "rows": [
            {"name": "core_course_get_courses", "description": "", "component": "moodle", "iswrite": false, "checked": true},
            {"name": "core_course_delete_courses", "description": "", "component": "moodle", "iswrite": true, "checked": false}
        ]
    }
}}
<table class="table table-sm table-hover small">
    <thead>
        <tr>
            <th scope="col">
                <input type="checkbox" data-action="local_jedomi/admin/apis/check-all"
                       aria-label="{{#str}} selectall, moodle {{/str}}">
            </th>
            <th scope="col">{{#str}} ws_name, local_jedomi {{/str}}</th>
            <th scope="col">{{#str}} ws_description, local_jedomi {{/str}}</th>
            <th scope="col">{{#str}} ws_component, local_jedomi {{/str}}</th>
            <th scope="col">{{#str}} ws_type, local_jedomi {{/str}}</th>
        </tr>
    </thead>
    <tbody data-region="local_jedomi/admin/apis/rows">
        {{#hasrows}}
        {{#rows}}
        <tr class="{{#iswrite}}local_jedomi-ws-write{{/iswrite}}">
            <td><input type="hidden" name="ws_{{role}}_shown[]" value="{{name}}"><input type="checkbox" data-region="local_jedomi/admin/apis/ws-check" name="ws_{{role}}[]" value="{{name}}"{{#checked}} checked{{/checked}} aria-label="{{name}}"></td>
            <td><code>{{name}}</code></td>
            <td class="local_jedomi-ws-description">{{description}}</td>
            <td><span class="badge badge-secondary bg-secondary">{{component}}</span></td>
            <td>
                {{#iswrite}}<span class="badge badge-danger bg-danger">{{#str}} ws_type_write, local_jedomi {{/str}}</span>{{/iswrite}}
                {{^iswrite}}<span class="badge badge-success bg-success">{{#str}} ws_type_read, local_jedomi {{/str}}</span>{{/iswrite}}
            </td>
        </tr>
        {{/rows}}
        {{/hasrows}}
        {{^hasrows}}
        <tr><td colspan="5" class="text-center text-muted py-4">{{#str}} ws_none_found, local_jedomi {{/str}}</td></tr>
        {{/hasrows}}
    </tbody>
</table>
