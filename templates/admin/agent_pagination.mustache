{{!
    @template local_jedomi/admin/agent_pagination

    Agent count and page links of the agent list, rendered by the local_jedomi/admin/agents module.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-action="local_jedomi/admin/agents/page" on each page link, with data-page

    Context variables required for this template:
    * total int - Number of agents that match the filters
    * pages array - Page links: page int, active bool

    Example context (json):
    {
        "total": 45,
        "pages": [{"page": 1, "active": true}, {"page": 2, "active": false}, {"page": 3, "active": false}]
    }
}}
<span class="text-muted small">{{#str}} agent_count, local_jedomi, {{total}} {{/str}}</span>
<nav aria-label="{{#str}} page, moodle {{/str}}">
    <ul class="pagination pagination-sm mb-0 flex-wrap">
        {{#pages}}
        <li class="page-item{{#active}} active{{/active}}">
            <a class="page-link" href="#" data-action="local_jedomi/admin/agents/page" data-page="{{page}}"{{#active}} aria-current="page"{{/active}}>{{page}}</a>
        </li>
        {{/pages}}
    </ul>
</nav>
