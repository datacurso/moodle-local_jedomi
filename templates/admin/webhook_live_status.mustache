{{!
    @template local_jedomi/admin/webhook_live_status

    Result of a live check of the Telegram webhook, rendered by the local_jedomi/admin/integrations module.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * ok bool - Whether getWebhookInfo answered
    * error string - Error when ok is false
    * networkerror bool - Whether the request itself failed
    * url string - Webhook URL registered in Telegram
    * pending int - Updates waiting in the Telegram queue
    * haspending bool - Whether pending is greater than 0
    * telegramerror string - Last error reported by Telegram
    * storederror string - Result of the last webhook registration from this site
    * storederrortime int - Time of that result; 0 when unknown
    * healthy bool - Whether there are no errors

    Example context (json):
    {
        "ok": true, "error": "", "networkerror": false, "url": "https://example.com/local/jedomi/telegram_webhook.php?secret=abc",
        "pending": 2, "haspending": true, "telegramerror": "", "storederror": "", "storederrortime": 0, "healthy": true
    }
}}
<div class="small">
    {{^ok}}
    <div class="d-flex align-items-start local_jedomi-admin-text-warn">
        <i class="fa fa-times-circle mr-2 mt-1" aria-hidden="true"></i>
        <div>
            <strong class="d-block">{{#networkerror}}{{#str}} webhook_live_network_error, local_jedomi {{/str}}{{/networkerror}}{{^networkerror}}{{#str}} webhook_live_api_error, local_jedomi {{/str}}{{/networkerror}}</strong>
            <span>{{error}}</span>
        </div>
    </div>
    {{/ok}}
    {{#ok}}
    <div class="mb-2">
        <strong>{{#str}} webhook_live_url, local_jedomi {{/str}}</strong><br>
        <code class="local_jedomi-admin-break">{{url}}</code>
    </div>
    <div class="mb-2">
        <strong>{{#str}} webhook_live_pending, local_jedomi {{/str}}</strong>
        <span class="font-weight-bold fw-bold {{#haspending}}local_jedomi-admin-text-warn{{/haspending}}{{^haspending}}local_jedomi-admin-text-ok{{/haspending}}">{{pending}}</span>
    </div>
    {{#telegramerror}}
    <div class="local_jedomi-admin-status local_jedomi-admin-status-warn mb-2">
        <i class="fa fa-exclamation-triangle mr-1" aria-hidden="true"></i>
        <strong>{{#str}} webhook_live_telegram_error, local_jedomi {{/str}}</strong><br>
        <span>{{telegramerror}}</span>
    </div>
    {{/telegramerror}}
    {{#storederror}}
    <div class="local_jedomi-admin-status local_jedomi-admin-status-warn">
        <i class="fa fa-info-circle mr-1" aria-hidden="true"></i>
        <strong>{{#str}} webhook_live_last_registration, local_jedomi {{/str}}</strong><br>
        <span>{{storederror}}</span>
        {{#storederrortime}}
        <br><span class="text-muted">{{#userdate}} {{storederrortime}}, {{#str}} strftimedatetime, core_langconfig {{/str}} {{/userdate}}</span>
        {{/storederrortime}}
    </div>
    {{/storederror}}
    {{#healthy}}
    <div class="local_jedomi-admin-text-ok"><i class="fa fa-check-circle mr-1" aria-hidden="true"></i>{{#str}} webhook_live_healthy, local_jedomi {{/str}}</div>
    {{/healthy}}
    {{/ok}}
</div>
