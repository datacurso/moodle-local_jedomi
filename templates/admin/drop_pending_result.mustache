{{!
    @template local_jedomi/admin/drop_pending_result

    Result of dropping the pending Telegram updates, rendered by the local_jedomi/admin/integrations module.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * success bool - Whether the pending updates were dropped
    * error string - Error detail when success is false (optional)

    Example context (json):
    {
        "success": false,
        "error": "Bot token not configured"
    }
}}
{{#success}}
<span class="local_jedomi-admin-text-ok">{{#str}} drop_pending_success, local_jedomi {{/str}}</span>
{{/success}}
{{^success}}
<span class="local_jedomi-admin-text-warn">{{#str}} drop_pending_fail, local_jedomi {{/str}}</span>
{{#error}}<br><span class="text-muted">{{error}}</span>{{/error}}
{{/success}}
