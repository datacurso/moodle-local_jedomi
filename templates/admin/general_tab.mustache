{{!
    @template local_jedomi/admin/general_tab

    General tab of the Jedomi settings: link to the AI service settings in the Datacurso AI provider
    and the general settings form.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * provider object - Link to the provider: url string
    * form string - HTML of the general settings form, rendered by moodleform

    Example context (json):
    {
        "provider": {"url": "https://example.com/ai/provider/datacurso/admin/plugin_settings.php?component=local_jedomi"},
        "form": "<form></form>"
    }
}}
<div class="local_jedomi-admin local_jedomi-admin-general_tab">
    {{< local_jedomi/admin/card }}
        {{$icon}}fa-plug{{/icon}}
        {{$color}}violet{{/color}}
        {{$title}}{{#str}} ai_heading, local_jedomi {{/str}}{{/title}}
        {{$subtitle}}{{#str}} ai_heading_help, local_jedomi {{/str}}{{/subtitle}}
        {{$body}}{{#provider}}{{> local_jedomi/provider_settings_link }}{{/provider}}{{/body}}
    {{/ local_jedomi/admin/card }}
    {{{form}}}
</div>
