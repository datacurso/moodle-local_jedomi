{{!
    @template local_jedomi/admin/profiler_tab

    Profiler tab of the Jedomi settings: statistics, slowest queries and recent queries of every channel, filtered
    and paginated.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * total int - Number of logged queries
    * slow int - Number of slow queries
    * avg float - Average duration in milliseconds
    * max float - Maximum duration in milliseconds
    * actionurl string - URL of the settings page, for the filter form
    * minms int|string - Current minimum duration filter; empty for none
    * sortduration bool - Whether recent queries are sorted by duration
    * sorttime bool - Whether recent queries are sorted by time
    * channels array - Channel filter options: value string, label string, selected bool
    * pagingbar string - HTML of the paging bar; empty when every query fits in one page
    * hasslowest bool - Whether there are slow queries
    * slowest array - Slowest queries: query string, avg float, max float, count int
    * hasrecent bool - Whether there are recent queries
    * recent array - Recent queries: agentid int, origin string, agenturl string (empty when there is no agent to
      open), userfullname string, query string, duration float, slow bool, rowcount int, timecreated int

    Example context (json):
    {
        "total": 12, "slow": 2, "avg": 3.5, "max": 1500, "actionurl": "https://example.com/local/jedomi/admin_settings.php",
        "minms": "", "sortduration": true, "sorttime": false, "pagingbar": "",
        "channels": [{"value": "", "label": "All channels", "selected": true}, {"value": "web", "label": "Web chat", "selected": false}],
        "hasslowest": true, "slowest": [{"query": "SELECT * FROM {user}", "avg": 12.3, "max": 20.1, "count": 4}],
        "hasrecent": true,
        "recent": [{"agentid": 9, "origin": "Agent #9", "agenturl": "#", "userfullname": "Admin User", "query": "SELECT 1", "duration": 5.2,
            "slow": false, "rowcount": 1, "timecreated": 1700000000}]
    }
}}
<div class="local_jedomi-admin local_jedomi-admin-profiler_tab">
    {{< local_jedomi/admin/card }}
        {{$icon}}{{#pix}} i/dashboard, core {{/pix}}{{/icon}}
        {{$color}}amber{{/color}}
        {{$title}}{{#str}} query_profiler_heading, local_jedomi {{/str}}{{/title}}
        {{$body}}
            <p class="text-muted small">{{#str}} query_profiler_desc, local_jedomi {{/str}}</p>

            <div class="row text-center mb-3">
                <div class="col-md-3">
                    <span class="badge badge-info bg-info local_jedomi-admin-stat">{{total}}</span>
                    <div class="small text-muted mt-1">{{#str}} query_profiler_total, local_jedomi {{/str}}</div>
                </div>
                <div class="col-md-3">
                    <span class="badge badge-warning bg-warning local_jedomi-admin-stat">{{slow}}</span>
                    <div class="small text-muted mt-1">{{#str}} query_profiler_slow, local_jedomi {{/str}}</div>
                </div>
                <div class="col-md-3">
                    <span class="badge badge-secondary bg-secondary local_jedomi-admin-stat">{{#str}} query_profiler_ms, local_jedomi, {{avg}} {{/str}}</span>
                    <div class="small text-muted mt-1">{{#str}} query_profiler_avg, local_jedomi {{/str}}</div>
                </div>
                <div class="col-md-3">
                    <span class="badge badge-danger bg-danger local_jedomi-admin-stat">{{#str}} query_profiler_ms, local_jedomi, {{max}} {{/str}}</span>
                    <div class="small text-muted mt-1">{{#str}} query_profiler_max, local_jedomi {{/str}}</div>
                </div>
            </div>

            <form method="get" action="{{actionurl}}" class="mb-3">
                <input type="hidden" name="tab" value="profiler">
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <label class="sr-only visually-hidden" for="{{uniqid}}-qp-min">{{#str}} query_profiler_min_ms, local_jedomi {{/str}}</label>
                        <input type="number" id="{{uniqid}}-qp-min" name="qp_min_ms" class="form-control form-control-sm" min="0"
                               placeholder="{{#str}} query_profiler_min_ms, local_jedomi {{/str}}" value="{{minms}}">
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="sr-only visually-hidden" for="{{uniqid}}-qp-channel">{{#str}} query_profiler_channel, local_jedomi {{/str}}</label>
                        <select id="{{uniqid}}-qp-channel" name="qp_channel" class="custom-select custom-select-sm form-select form-select-sm w-100">
                            {{#channels}}
                            <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
                            {{/channels}}
                        </select>
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="sr-only visually-hidden" for="{{uniqid}}-qp-sort">{{#str}} sortby, moodle {{/str}}</label>
                        <select id="{{uniqid}}-qp-sort" name="qp_sort" class="custom-select custom-select-sm form-select form-select-sm w-100">
                            <option value="duration_ms"{{#sortduration}} selected{{/sortduration}}>{{#str}} query_profiler_sort_duration, local_jedomi {{/str}}</option>
                            <option value="timecreated"{{#sorttime}} selected{{/sorttime}}>{{#str}} query_profiler_sort_time, local_jedomi {{/str}}</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-2">
                        <button type="submit" class="btn btn-sm btn-primary w-100">{{#pix}} i/filter, core {{/pix}}{{#str}} agent_apply_filters, local_jedomi {{/str}}</button>
                    </div>
                </div>
            </form>

            <h6 class="mt-3">{{#str}} query_profiler_slowest, local_jedomi {{/str}}</h6>
            {{#hasslowest}}
            <div class="table-responsive">
                <table class="table table-sm table-hover small">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} query_profiler_sort_query, local_jedomi {{/str}}</th>
                            <th scope="col">{{#str}} query_profiler_avg, local_jedomi {{/str}}</th>
                            <th scope="col">{{#str}} query_profiler_max, local_jedomi {{/str}}</th>
                            <th scope="col">#</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#slowest}}
                        <tr>
                            <td><code class="local_jedomi-admin-break">{{query}}</code></td>
                            <td class="text-danger text-nowrap">{{#str}} query_profiler_ms, local_jedomi, {{avg}} {{/str}}</td>
                            <td class="text-nowrap">{{#str}} query_profiler_ms, local_jedomi, {{max}} {{/str}}</td>
                            <td>{{count}}</td>
                        </tr>
                        {{/slowest}}
                    </tbody>
                </table>
            </div>
            {{/hasslowest}}
            {{^hasslowest}}
            <div class="alert alert-info">{{#str}} query_profiler_empty, local_jedomi {{/str}}</div>
            {{/hasslowest}}

            <h6 class="mt-4">{{#str}} query_profiler_recent, local_jedomi {{/str}}</h6>
            {{#hasrecent}}
            <div class="table-responsive">
                <table class="table table-sm table-hover small">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} query_profiler_origin, local_jedomi {{/str}}</th>
                            <th scope="col">{{#str}} query_profiler_user, local_jedomi {{/str}}</th>
                            <th scope="col">{{#str}} query_profiler_sort_query, local_jedomi {{/str}}</th>
                            <th scope="col">{{#str}} query_profiler_sort_duration, local_jedomi {{/str}}</th>
                            <th scope="col">{{#str}} query_profiler_rows, local_jedomi {{/str}}</th>
                            <th scope="col">{{#str}} query_profiler_sort_time, local_jedomi {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#recent}}
                        <tr>
                            <td>{{#agenturl}}<a href="{{agenturl}}" class="badge badge-info bg-info">{{origin}}</a>{{/agenturl}}{{^agenturl}}<span class="badge badge-secondary bg-secondary">{{origin}}</span>{{/agenturl}}</td>
                            <td>{{#userfullname}}{{userfullname}}{{/userfullname}}{{^userfullname}}?{{/userfullname}}</td>
                            <td><code class="local_jedomi-admin-break">{{query}}</code></td>
                            <td class="text-nowrap{{#slow}} text-danger{{/slow}}">{{#str}} query_profiler_ms, local_jedomi, {{duration}} {{/str}}</td>
                            <td>{{rowcount}}</td>
                            <td class="text-nowrap">{{#userdate}} {{timecreated}}, {{#str}} strftimedatetime, core_langconfig {{/str}} {{/userdate}}</td>
                        </tr>
                        {{/recent}}
                    </tbody>
                </table>
            </div>
            {{{pagingbar}}}
            {{/hasrecent}}
            {{^hasrecent}}
            <div class="alert alert-info mt-3">{{#str}} query_profiler_empty, local_jedomi {{/str}}</div>
            {{/hasrecent}}
        {{/body}}
    {{/ local_jedomi/admin/card }}
</div>
