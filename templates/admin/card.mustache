{{!
    @template local_jedomi/admin/card

    Card with an icon, a title and a subtitle, used by the tabs of the Jedomi settings.
    Callers extend it and fill the blocks.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Blocks:
    * icon - Font Awesome icon class, for example fa-plug
    * color - Icon color modifier: violet, amber, green, red, sky, indigo, purple or blue
    * title - Card title (defaults to the plugin name)
    * subtitle - Card subtitle (optional)
    * body - Card content

    Example context (json):
    {}
}}
<div class="card local_jedomi-admin-card mb-4">
    <div class="card-header local_jedomi-admin-card-header">
        <span class="local_jedomi-admin-card-icon local_jedomi-admin-card-icon-{{$color}}violet{{/color}}">
            <i class="fa {{$icon}}fa-cog{{/icon}}" aria-hidden="true"></i>
        </span>
        <div>
            <h5 class="mb-0">{{$title}}{{#str}} pluginname, local_jedomi {{/str}}{{/title}}</h5>
            <small class="text-muted d-block">{{$subtitle}}{{/subtitle}}</small>
        </div>
    </div>
    <div class="card-body">
        {{$body}}{{/body}}
    </div>
</div>
