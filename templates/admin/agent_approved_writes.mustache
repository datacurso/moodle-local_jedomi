{{!
    @template local_jedomi/admin/agent_approved_writes

    Checkboxes of the web service functions that change data and that an agent may run without confirmation, in the
    agent form of the Agents tab. The local_jedomi/admin/agents module renders it again with the functions of the
    owner when an agent is edited.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * approvablewrites array - Functions that may be approved: name string, checked bool

    Example context (json):
    {
        "approvablewrites": [{"name": "core_message_send_instant_messages", "checked": true}]
    }
}}
{{! A hidden empty value is always sent, so unchecking every box removes the approved writes of the agent. }}
<input type="hidden" name="approved_writes[]" value="">
{{#approvablewrites}}
<div class="form-check">
    <input class="form-check-input" type="checkbox" name="approved_writes[]" value="{{name}}" id="{{uniqid}}-agent-write-{{name}}"{{#checked}} checked{{/checked}}>
    <label class="form-check-label" for="{{uniqid}}-agent-write-{{name}}"><code>{{name}}</code></label>
</div>
{{/approvablewrites}}
{{^approvablewrites}}
<p class="text-muted small mb-0">{{#str}} agent_approved_writes_none, local_jedomi {{/str}}</p>
{{/approvablewrites}}
