{{!
    @template local_jedomi/sidebar

    Jedomi AI sidebar injected on every page by the local_jedomi/sidebar module: trigger button, drawer with
    header, messages, thinking indicator, quick actions and input area, and file drop zone.
    The element ids are kept because the sidebar is a single instance per page and styles.css targets them.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * the element ids (jedomi-trigger, jedomi-sidebar, jedomi-input, ...) are used by local_jedomi/sidebar
    * data-action="local_jedomi/sidebar/voice-mode-exit" - Ends the voice conversation
    * data-region="local_jedomi/sidebar/voice-mode-state" - State of the voice conversation, updated by JS
    * data-region="local_jedomi/sidebar/voice-mode-level" - Indicator scaled by JS with the microphone level
    * jedomi-file-preview - Filled by JS with local_jedomi/local/sidebar/file_chips, one chip per attached file

    Context variables required for this template:
    * greeting string - Greeting with the user name
    * strings object - Sidebar strings from local_jedomi_get_sidebar_config(): open_sidebar, export_conversation, half_width,
      full_width, new_conversation, close, hello, thinking, toggle_thinking, placeholder, message_input, attach,
      attach_image, image, attach_file, file, attach_audio, audio_file, voice_input, send, attached_image, ai_disclaimer,
      drop_files_here, voice_mode, voice_mode_exit, voice_mode_listening, keyboard_shortcuts, stop_answer
    * files_enabled bool - File and image processing is on: image and file attach options
    * audio_enabled bool - Audio processing is on: microphone, voice message bar and audio attach option
    * attach_enabled bool - At least one of the two is on: attach button and drop zone
    * voice_enabled bool - The voice conversation is on: its button next to the microphone and its view

    Example context (json):
    {
        "greeting": "Hi, Ana!",
        "strings": {"open_sidebar": "Open Jedomi AI", "hello": "I am Jedomi.", "placeholder": "Ask Jedomi...",
            "send": "Send", "thinking": "Thinking...", "ai_disclaimer": "Jedomi is an AI and can make mistakes."},
        "files_enabled": true,
        "audio_enabled": false,
        "attach_enabled": true,
        "voice_enabled": false
    }
}}
<button type="button" id="jedomi-trigger" class="jedomi-trigger" aria-label="{{strings.open_sidebar}}" title="{{strings.keyboard_shortcuts}}"
    aria-controls="jedomi-sidebar" aria-expanded="false" aria-keyshortcuts="Alt+Shift+J">
    <svg aria-hidden="true" focusable="false" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.107 7.107c0 .13 0 .261 0 .393a7.5 7.5 0 0 0-7.107 7.107c-.13 0-.261 0-.393 0a7.5 7.5 0 0 0-7.107-7.107c0-.132 0-.263 0-.393a7.5 7.5 0 0 0 7.107-7.107z"/><path d="M5 5.5v3M6.5 7H3.5M19 15.5v3M20.5 17H17.5"/></svg>
    <span class="jedomi-trigger-label">Jedomi</span>
</button>

<div id="jedomi-sidebar" class="jedomi-sidebar jedomi-closed" role="dialog" aria-modal="true" aria-label="Jedomi AI"
    aria-describedby="jedomi-shortcuts-help" aria-hidden="true" inert>
    <span id="jedomi-shortcuts-help" class="sr-only">{{strings.keyboard_shortcuts}}</span>
    <div class="jedomi-header">
        <div class="jedomi-header-info">
            <div class="jedomi-logo"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.107 7.107c0 .13 0 .261 0 .393a7.5 7.5 0 0 0-7.107 7.107c-.13 0-.261 0-.393 0a7.5 7.5 0 0 0-7.107-7.107c0-.132 0-.263 0-.393a7.5 7.5 0 0 0 7.107-7.107z"/><path d="M5 5.5v3M6.5 7H3.5M19 15.5v3M20.5 17H17.5"/></svg></div>
            <div>
                <span id="jedomi-context-label" class="jedomi-context-badge jedomi-hidden"></span>
            </div>
        </div>
        <div class="jedomi-header-actions">
            <button type="button" id="jedomi-export" class="jedomi-btn-icon" title="{{strings.export_conversation}}" aria-label="{{strings.export_conversation}}"><svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></button>
            <button type="button" id="jedomi-expand-half" class="jedomi-btn-icon jedomi-expand-btn" title="{{strings.half_width}}"
                aria-label="{{strings.half_width}}" data-mode="half">
                <svg aria-hidden="true" focusable="false" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="8" height="18" rx="1"/><rect x="13" y="3" width="8" height="18" rx="1" opacity=".4"/></svg>
            </button>
            <button type="button" id="jedomi-expand-full" class="jedomi-btn-icon jedomi-expand-btn" title="{{strings.full_width}}"
                aria-label="{{strings.full_width}}" data-mode="full">
                <svg aria-hidden="true" focusable="false" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            </button>
            <button type="button" id="jedomi-clear" class="jedomi-btn-icon jedomi-btn-new" title="{{strings.new_conversation}}"
                aria-label="{{strings.new_conversation}}" aria-keyshortcuts="Alt+Shift+N"><span aria-hidden="true">+</span></button>
            <button type="button" id="jedomi-close" class="jedomi-btn-icon" title="{{strings.close}}" aria-label="{{strings.close}}"><svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
        </div>
    </div>

    <div id="jedomi-messages" class="jedomi-messages" role="log" aria-live="polite" aria-relevant="additions" aria-busy="false">
        <div class="jedomi-message jedomi-message-assistant">
            <div class="jedomi-bubble">
                {{greeting}}<br>
                {{strings.hello}}
            </div>
        </div>
    </div>

    <div id="jedomi-thinking-wrapper" class="jedomi-thinking-wrapper jedomi-hidden">
        <button type="button" id="jedomi-thinking-toggle-btn" class="jedomi-thinking-bar" aria-label="{{strings.toggle_thinking}}">
            <span class="jedomi-thinking-dot"></span>
            <span class="jedomi-thinking-lbl">{{strings.thinking}}</span>
            <svg aria-hidden="true" focusable="false" class="jedomi-thinking-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div id="jedomi-thinking" class="jedomi-thinking">
            <span></span><span></span><span></span>
        </div>
    </div>

    <div id="jedomi-quick-actions" class="jedomi-quick-actions"></div>

    <div class="jedomi-input-area">
        {{#audio_enabled}}
        <div id="jedomi-voice-bar" class="jedomi-hidden"></div>
        {{/audio_enabled}}
        {{#voice_enabled}}
        <div id="jedomi-voice-mode" class="jedomi-voice-mode jedomi-hidden">
            <span class="jedomi-voice-mode-orb" data-region="local_jedomi/sidebar/voice-mode-level" aria-hidden="true"></span>
            <span class="jedomi-voice-mode-state" data-region="local_jedomi/sidebar/voice-mode-state" role="status" aria-live="polite">{{strings.voice_mode_listening}}</span>
            <button type="button" class="jedomi-voice-mode-exit" data-action="local_jedomi/sidebar/voice-mode-exit"
                title="{{strings.voice_mode_exit}}" aria-label="{{strings.voice_mode_exit}}"><svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
        </div>
        {{/voice_enabled}}
        <div class="jedomi-input-row" data-action="local_jedomi/sidebar/focus-input">
            <textarea id="jedomi-input" class="jedomi-input" placeholder="{{strings.placeholder}}"
                rows="1" aria-label="{{strings.message_input}}"></textarea>
            <div class="jedomi-input-actions">
                {{#attach_enabled}}
                <div class="jedomi-attach-wrap">
                    <button type="button" id="jedomi-attach-btn" class="jedomi-input-icon" title="{{strings.attach}}" aria-label="{{strings.attach}}"
                        aria-haspopup="true" aria-expanded="false" aria-controls="jedomi-attach-menu"><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
                    <div id="jedomi-attach-menu" class="jedomi-attach-menu jedomi-hidden">
                        {{#files_enabled}}
                        <button type="button" class="jedomi-attach-option" data-type="image" title="{{strings.attach_image}}"><svg aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg> {{strings.image}}</button>
                        <button type="button" class="jedomi-attach-option" data-type="file" title="{{strings.attach_file}}"><svg aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg> {{strings.file}}</button>
                        {{/files_enabled}}
                        {{#audio_enabled}}
                        <button type="button" class="jedomi-attach-option" data-type="audio" title="{{strings.attach_audio}}"><svg aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg> {{strings.audio_file}}</button>
                        {{/audio_enabled}}
                    </div>
                </div>
                {{/attach_enabled}}
                {{#audio_enabled}}
                <button type="button" id="jedomi-voice-btn" class="jedomi-input-icon" title="{{strings.voice_input}}" aria-label="{{strings.voice_input}}"><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><line x1="12" y1="17" x2="12" y2="22"/></svg></button>
                {{/audio_enabled}}
                {{#voice_enabled}}
                <button type="button" id="jedomi-voice-mode-btn" class="jedomi-input-icon" title="{{strings.voice_mode}}" aria-label="{{strings.voice_mode}}"><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="10" x2="4" y2="14"/><line x1="8" y1="6" x2="8" y2="18"/><line x1="12" y1="3" x2="12" y2="21"/><line x1="16" y1="7" x2="16" y2="17"/><line x1="20" y1="10" x2="20" y2="14"/></svg></button>
                {{/voice_enabled}}
                <button type="button" id="jedomi-send" class="jedomi-send-btn" title="{{strings.send}}" aria-label="{{strings.send}}"><svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></button>
                <button type="button" id="jedomi-stop" class="jedomi-send-btn jedomi-stop-btn jedomi-hidden" title="{{strings.stop_answer}}"
                    aria-label="{{strings.stop_answer}}"><svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><rect x="5" y="5" width="14" height="14" rx="2"/></svg></button>
            </div>
        </div>
        {{#files_enabled}}
        <input type="file" id="jedomi-image-input" accept="image/jpeg,image/png,image/webp" class="jedomi-hidden" aria-hidden="true">
        <input type="file" id="jedomi-file-input" accept=".pdf,.csv,.txt,.md,.doc,.docx,.ppt,.pptx" multiple class="jedomi-hidden" aria-hidden="true">
        {{/files_enabled}}
        {{#audio_enabled}}
        <input type="file" id="jedomi-audio-input" accept=".ogg,.oga,.opus,.webm,.mp3,.m4a,.mp4,.wav" multiple class="jedomi-hidden" aria-hidden="true">
        {{/audio_enabled}}
        <div id="jedomi-image-preview" class="jedomi-image-preview jedomi-hidden">
            <img id="jedomi-preview-img" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="{{strings.attached_image}}">
            <span>{{strings.attached_image}}</span>
            <button type="button" id="jedomi-remove-image" class="jedomi-input-icon" title="{{strings.close}}" aria-label="{{strings.close}}"><svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
        </div>
        <div id="jedomi-file-preview" class="jedomi-file-chips jedomi-hidden"></div>
    </div>
    <div class="jedomi-footer">
        <span class="jedomi-disclaimer">{{strings.ai_disclaimer}}</span>
    </div>
</div>

{{#attach_enabled}}
<div id="jedomi-dropzone" class="jedomi-dropzone jedomi-hidden">
    <div class="jedomi-dropzone-inner">
        <svg aria-hidden="true" focusable="false" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <span class="jedomi-dropzone-text">{{strings.drop_files_here}}</span>
    </div>
</div>
{{/attach_enabled}}
