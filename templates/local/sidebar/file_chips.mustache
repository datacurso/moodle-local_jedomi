{{!
    @template local_jedomi/local/sidebar/file_chips

    Chips of the files attached to the next message, each one with its remove button. The files are read only when
    the message is sent.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-action="local_jedomi/sidebar/remove-file" - Removes the attached file at data-index

    Context variables required for this template:
    * files array - Attached files: index (position in the list), name and removelabel (accessible label of the button)

    Example context (json):
    {
        "files": [
            {"index": 0, "name": "notes.txt", "removelabel": "Remove notes.txt"},
            {"index": 1, "name": "report.pdf", "removelabel": "Remove report.pdf"}
        ]
    }
}}
{{#files}}
<div class="jedomi-image-preview jedomi-file-chip">
    <span>📎 {{name}}</span>
    <button type="button" class="jedomi-input-icon" data-action="local_jedomi/sidebar/remove-file" data-index="{{index}}" aria-label="{{removelabel}}" title="{{removelabel}}"><svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
</div>
{{/files}}
