{{!
    @template local_jedomi/local/sidebar/quick_actions

    Quick action buttons of the Jedomi sidebar, rendered by the local_jedomi/sidebar module for the role and page.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-msg on each button: the message sent when it is clicked

    Context variables required for this template:
    * actions array - Buttons: label string, msg string, icon object (see local_jedomi/local/sidebar/icon)

    Example context (json):
    {
        "actions": [{"label": "Overview", "msg": "Give me a summary of the platform", "icon": {"chart": true} }]
    }
}}
{{#actions}}
<button class="jedomi-quick-btn" data-msg="{{msg}}">{{> local_jedomi/local/sidebar/icon }} {{label}}</button>
{{/actions}}
