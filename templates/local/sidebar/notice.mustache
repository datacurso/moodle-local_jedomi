{{!
    @template local_jedomi/local/sidebar/notice

    Assistant message with plain text, such as the notice shown when a new conversation starts.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * text string - Message text

    Example context (json):
    {
        "text": "New conversation started. How can I help you?"
    }
}}
<div class="jedomi-message jedomi-message-assistant">
    <div class="jedomi-bubble">{{text}}</div>
</div>
