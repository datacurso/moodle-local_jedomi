{{!
    @template local_jedomi/local/sidebar/tool_status

    Status line shown in the answer bubble while a tool runs.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * label string - What the tool is doing
    * icon object - Icon flag, see local_jedomi/local/sidebar/icon

    Example context (json):
    {
        "label": "Querying the database...",
        "icon": {"db": true}
    }
}}
<span class="jedomi-tool-status">{{> local_jedomi/local/sidebar/icon }} {{label}}</span>
