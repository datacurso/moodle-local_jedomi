{{!
    @template local_jedomi/local/sidebar/user_actions

    Edit button under a user message.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-action="local_jedomi/sidebar/edit" on the button

    Context variables required for this template:
    * strings object - Sidebar strings: action_edit, action_edit_title

    Example context (json):
    {
        "strings": {"action_edit": "Edit", "action_edit_title": "Edit message"}
    }
}}
<button class="jedomi-action-btn" data-action="local_jedomi/sidebar/edit" title="{{strings.action_edit_title}}"><svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg> {{strings.action_edit}}</button>
