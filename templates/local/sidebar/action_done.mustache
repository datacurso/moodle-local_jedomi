{{!
    @template local_jedomi/local/sidebar/action_done

    Outcome of a confirmed or cancelled action, shown in place of the confirmation card.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * text string - Outcome message
    * note string - Extra note, such as where recipients see the messages (optional)

    Example context (json):
    {
        "text": "✅ 3 messages sent.",
        "note": "Recipients will see them in their Moodle message inbox."
    }
}}
<div class="jedomi-confirm-msg">{{text}}</div>
{{#note}}<small>{{note}}</small>{{/note}}
