{{!
    @template local_jedomi/local/sidebar/feedback_comment

    Optional comment of an answer rated as in need of improvement.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="local_jedomi/sidebar/feedback-comment-text" on the text field
    * data-action="local_jedomi/sidebar/feedback-comment-send" on the button

    Context variables required for this template:
    * uniqid string - Unique id of the field
    * strings object - Sidebar strings: feedback_comment, feedback_comment_send

    Example context (json):
    {
        "uniqid": "jedomi-comment-1",
        "strings": {"feedback_comment": "What could be improved? (optional)", "feedback_comment_send": "Send comment"}
    }
}}
<div class="jedomi-feedback-comment">
    <label class="sr-only" for="{{uniqid}}">{{strings.feedback_comment}}</label>
    <textarea id="{{uniqid}}" class="form-control form-control-sm" rows="2" maxlength="1000"
        placeholder="{{strings.feedback_comment}}" data-region="local_jedomi/sidebar/feedback-comment-text"></textarea>
    <button type="button" class="btn btn-secondary btn-sm mt-1"
        data-action="local_jedomi/sidebar/feedback-comment-send">{{strings.feedback_comment_send}}</button>
</div>
