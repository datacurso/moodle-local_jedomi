<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/jedomi/db" VERSION="2026102700" COMMENT="XMLDB file for local_jedomi plugin - Telegram + Agent Scheduled Tasks tables">
    <TABLES>
        <TABLE NAME="local_jedomi_telegram_links" COMMENT="Links between Moodle users and Telegram chat IDs">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="chatid" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="username" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="confirmed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="lastproactivesent" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="lastused" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last message or button of the chat; the link expires 30 days after it"/>
                <FIELD NAME="pinhash" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="password_hash of the Telegram PIN of an administrator or manager"/>
                <FIELD NAME="pinfailures" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Wrong PINs in a row"/>
                <FIELD NAME="pinlockeduntil" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Telegram writes locked until this time after too many wrong PINs"/>
                <FIELD NAME="pinverifiedat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last right PIN; writes run without asking it again for 15 minutes"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="userid" TYPE="unique" FIELDS="userid"/>
                <KEY NAME="chatid" TYPE="unique" FIELDS="chatid"/>
            </KEYS>
        </TABLE>

        <TABLE NAME="local_jedomi_telegram_sessions" COMMENT="Conversational context per Telegram chat_id (TTL 30min)">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="chatid" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="messages" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="usercontext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="iteration" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Tool loop iteration of the saved state, to reject stale writes"/>
                <FIELD NAME="lastactivity" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="chatid" TYPE="unique" FIELDS="chatid"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="lastactivity_idx" UNIQUE="false" FIELDS="lastactivity"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_jedomi_telegram_pending_actions" COMMENT="Pending confirmation actions from inline buttons">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="callbackid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="chatid" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="actionjson" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Course the role is computed in when the action is confirmed; 0 outside a course"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="callbackid" TYPE="unique" FIELDS="callbackid"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="chatid_idx" UNIQUE="false" FIELDS="chatid"/>
                <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_jedomi_telegram_rate_limit" COMMENT="Rate limiting per Telegram chat_id">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="chatid" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="windowstart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="msgcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="blockeduntil" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="chatid" TYPE="unique" FIELDS="chatid"/>
            </KEYS>
        </TABLE>

        <TABLE NAME="local_jedomi_agents" COMMENT="Scheduled AI agent definitions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="prompt" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="schedule_cron" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="context_type" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="site" SEQUENCE="false"/>
                <FIELD NAME="context_id" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="role_filter" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="lastrun" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="nextrun" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="failcount" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="lastresult" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Answer of the last successful run"/>
                <FIELD NAME="lasterror" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Reason of the last failed run, empty after a success"/>
                <FIELD NAME="approvedwrites" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON list of the web service functions that write and that the agent may run without confirmation; empty for none"/>
                <FIELD NAME="runwrites" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON list of the writes the current scheduled run already attempted (fingerprint, outcome, recipients), kept across its retries and cleared when a run succeeds"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="enabled_nextrun_idx" UNIQUE="false" FIELDS="enabled, nextrun"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_jedomi_agent_cache" COMMENT="Cache of agent execution results keyed by context hash">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="agentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="context_hash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="result_json" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="plan_json" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="agentid_context_hash_idx" UNIQUE="true" FIELDS="agentid, context_hash"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_jedomi_query_log" COMMENT="Log of SQL queries run by every channel for the profiler">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="agentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="channel" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="agent" SEQUENCE="false" COMMENT="agent, preview, web, telegram or companion"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User the query ran for; 0 when unknown"/>
                <FIELD NAME="query" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="duration_ms" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="2"/>
                <FIELD NAME="rowcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="duration_idx" UNIQUE="false" FIELDS="duration_ms"/>
                <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
                <INDEX NAME="channel_idx" UNIQUE="false" FIELDS="channel"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_jedomi_feedback" COMMENT="Ratings users give to Jedomi answers">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="rating" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="good or bad"/>
                <FIELD NAME="sessionid" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="Browser chat session id"/>
                <FIELD NAME="messagetext" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Excerpt of the rated answer"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="messageid" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="Id the browser gives to the rated answer: one rating per answer and user"/>
                <FIELD NAME="feedbackcomment" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Optional comment of an answer rated as in need of improvement"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="When the rating or its comment last changed"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="usermessage_idx" UNIQUE="false" FIELDS="userid, messageid" COMMENT="Not unique: older ratings have no message id"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_jedomi_pending_actions" COMMENT="Web chat actions waiting for the user's confirmation">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User who must confirm the action"/>
                <FIELD NAME="agentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Scheduled agent that proposed the action; 0 for the web chat"/>
                <FIELD NAME="tool" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Tool the model called"/>
                <FIELD NAME="argsjson" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Tool arguments as JSON"/>
                <FIELD NAME="severity" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="critical, high or medium"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Course the role is computed in when the action is confirmed; 0 outside a course"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_jedomi_whatsapp_links" COMMENT="Links between Moodle users and WhatsApp identities (BSUID)">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="bsuid" TYPE="char" LENGTH="160" NOTNULL="true" SEQUENCE="false" COMMENT="Business-scoped user id of Meta: country code, a dot and up to 128 characters, used as it comes"/>
                <FIELD NAME="waid" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="WhatsApp id of Meta (digits without +), only when Meta shares it"/>
                <FIELD NAME="phone" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Phone number in E.164, only when known"/>
                <FIELD NAME="confirmed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="consentat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="When the user accepted the consent text"/>
                <FIELD NAME="consentversion" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Version of the consent text accepted"/>
                <FIELD NAME="consentcategories" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="Comma-separated categories accepted: chat, grades"/>
                <FIELD NAME="optedout" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 after the user asked to stop the messages"/>
                <FIELD NAME="optoutat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="lastinbound" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last message of the user; opens the 24-hour window"/>
                <FIELD NAME="lastused" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last use of the link; the link expires 30 days after it"/>
                <FIELD NAME="lastproactivesent" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="userid" TYPE="unique" FIELDS="userid"/>
                <KEY NAME="bsuid" TYPE="unique" FIELDS="bsuid"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="waid_idx" UNIQUE="false" FIELDS="waid"/>
                <INDEX NAME="lastinbound_idx" UNIQUE="false" FIELDS="lastinbound"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_jedomi_whatsapp_sessions" COMMENT="Conversational context per WhatsApp chat key (wa_ plus the BSUID)">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="chatid" TYPE="char" LENGTH="170" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="messages" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="usercontext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="iteration" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Tool loop iteration of the saved state, to reject stale writes"/>
                <FIELD NAME="lastactivity" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="chatid" TYPE="unique" FIELDS="chatid"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="lastactivity_idx" UNIQUE="false" FIELDS="lastactivity"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_jedomi_whatsapp_pending" COMMENT="WhatsApp actions waiting for the user's confirmation">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="callbackid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="chatid" TYPE="char" LENGTH="170" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="actionjson" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Course the role is computed in when the action is confirmed; 0 outside a course"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="callbackid" TYPE="unique" FIELDS="callbackid"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="chatid_idx" UNIQUE="false" FIELDS="chatid"/>
                <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_jedomi_whatsapp_rate" COMMENT="Rate limiting per WhatsApp chat key">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="chatid" TYPE="char" LENGTH="170" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="windowstart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="msgcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="blockeduntil" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="chatid" TYPE="unique" FIELDS="chatid"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_jedomi_whatsapp_inbox" COMMENT="WhatsApp messages received from Meta, one row per message; the unique wamid deduplicates retries">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="wamid" TYPE="char" LENGTH="128" NOTNULL="true" SEQUENCE="false" COMMENT="Message id of Meta"/>
                <FIELD NAME="bsuid" TYPE="char" LENGTH="160" NOTNULL="true" SEQUENCE="false" COMMENT="BSUID of the sender"/>
                <FIELD NAME="payload" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Message as received, encrypted with the key of the site; emptied when processed"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending, processing, done or failed"/>
                <FIELD NAME="attempts" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timeprocessed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="wamid" TYPE="unique" FIELDS="wamid"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
                <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_jedomi_whatsapp_usage" COMMENT="Monthly WhatsApp message counters per user">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="period" TYPE="int" LENGTH="6" NOTNULL="true" SEQUENCE="false" COMMENT="Month as YYYYMM"/>
                <FIELD NAME="inbound" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="outservice" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Free-form service messages sent"/>
                <FIELD NAME="outtemplate" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Template messages sent"/>
                <FIELD NAME="media" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Media files received"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="userid-period" TYPE="unique" FIELDS="userid, period"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>
